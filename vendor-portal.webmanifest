{
  "name": "Megawide Vendor Portal",
  "short_name": "Vendor Portal",
  "description": "Keep your company profile current and answer Megawide's requests for quotation.",
  "id": "/prc-app/vendor-portal",
  "start_url": "vendor-portal.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#EE2E24",
  "theme_color": "#EE2E24",
  "icons": [
    {
      "src": "assets/icons/vendor-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/icons/vendor-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/icons/vendor-icon-192-maskable.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "assets/icons/vendor-icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
